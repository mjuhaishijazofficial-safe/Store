# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys (not usable for Pakistan payouts yet,
# left blank; manual EasyPaisa/bank transfer is the real payment path below)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Gemini API — aistudio.google.com > Get API Key (free tier; used for AI
# Slip-Scan stock-in, Master Handoff Spec §10/§23: a photo of a supplier
# slip → structured item/qty/price JSON). No key = the Slip Scan button
# still shows, but a scan attempt fails with a clear message rather than
# a silent no-op — Barcode Scan / Manual Add stay available either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Manual payment details shown on the Billing page (EasyPaisa + Meezan Bank)
EASYPAISA_NUMBER=
EASYPAISA_TITLE=
MEEZAN_TITLE=
MEEZAN_ACCOUNT=
MEEZAN_IBAN=
MEEZAN_BRANCH=

# The one email allowed onto /dashboard/admin (payment claims across every
# shop) — must exactly match the email of your own login in this app.
ADMIN_EMAIL=

# Authorizes app/api/cron/check-grace-periods (Vercel Cron, see
# vercel.json) — Vercel sets this automatically for its own cron
# requests once this var exists; any random secret string works.
CRON_SECRET=

# Your deployed app URL (use http://localhost:3000 while developing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
