# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys (not usable for Pakistan payouts yet,
# left blank; manual EasyPaisa/bank transfer is the real payment path below)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Gemini API — aistudio.google.com > Get API Key (free tier; used for AI
# Slip-Scan stock-in, Master Handoff Spec §10/§23: a photo of a supplier
# slip → structured item/qty/price JSON). No key = the Slip Scan button
# still shows, but a scan attempt fails with a clear message rather than
# a silent no-op — Barcode Scan / Manual Add stay available either way.
GEMINI_API_KEY=
# 'gemini-flash-lite-latest', not 'gemini-flash-latest': the plain
# "flash" alias currently resolves to a model whose FREE tier allows
# only ~20 requests per day, which a voice assistant burns through in
# minutes (every command costs one intent-parse call). The "lite" alias
# carries a far larger free allowance and is more than capable of the
# short structured-output calls this app makes.
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI — platform.openai.com > API keys (used for "Eagle" Voice
# Commands' speech-to-text, app/api/voice/transcribe). No key = the mic
# button still shows, but a voice attempt fails with a clear "not set up
# yet" message rather than a silent no-op. NEXT_PUBLIC_VOICE_STT_PROVIDER
# defaults to 'whisper' (the STT *provider*, i.e. this whole
# server-backed path vs the browser's own free speech recognition — the
# name predates VOICE_STT_MODEL below and is kept for compatibility);
# set it to 'webspeech' to use the browser's free built-in recognition
# instead (weaker Urdu accuracy, zero cost, no key needed) while testing
# without this key set.
OPENAI_API_KEY=
NEXT_PUBLIC_VOICE_STT_PROVIDER=whisper
# The actual OpenAI transcription model — 'gpt-4o-mini-transcribe', not
# 'whisper-1'. Live-verified against a real account (2026-08): same
# endpoint/params, noticeably better real-word accuracy for Roman-Urdu/
# English-mixed, product-name-heavy speech. 'gpt-4o-transcribe' (bigger,
# slower, marginally more accurate) or 'whisper-1' (rollback) both work
# as drop-in overrides.
VOICE_STT_MODEL=gpt-4o-mini-transcribe

# Which provider understands the spoken command and answers questions.
# Defaults to OpenAI whenever OPENAI_API_KEY is set — deliberately, not
# arbitrarily: Gemini's free tier allows only ~20 requests per DAY on
# its flash models, and a voice assistant spends one per command, so it
# stopped working within minutes of real use. These are tiny text calls
# (~200 tokens, a small fraction of a cent each) on a key that's already
# funded for Whisper. Set to 'gemini' to switch back.
VOICE_LLM_PROVIDER=openai
VOICE_LLM_MODEL=gpt-4o-mini

# Manual payment details shown on the Billing page (EasyPaisa + Meezan Bank)
EASYPAISA_NUMBER=
EASYPAISA_TITLE=
MEEZAN_TITLE=
MEEZAN_ACCOUNT=
MEEZAN_IBAN=
MEEZAN_BRANCH=

# The one email allowed onto /dashboard/admin (payment claims across every
# shop) — must exactly match the email of your own login in this app.
ADMIN_EMAIL=

# Authorizes app/api/cron/check-grace-periods (Vercel Cron, see
# vercel.json) — Vercel sets this automatically for its own cron
# requests once this var exists; any random secret string works.
CRON_SECRET=

# Your deployed app URL (use http://localhost:3000 while developing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
